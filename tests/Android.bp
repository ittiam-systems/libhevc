package {
    // Inherit applicable licenses from root
    default_team: "trendy_team_android_media_codec_framework",
    default_applicable_licenses: ["external_libhevc_license"],
}

// Decoder Test Helper Library
cc_library_static {
    name: "libhevc_dec_helper",
    host_supported: false,
    srcs: [
        "decoder/DecHelper.cpp",
    ],
    export_include_dirs: ["decoder"],
    static_libs: [
        "libhevcdec",
        "libhevc_tests_common",
        "libgtest",
        "libgmock",
    ],
    shared_libs: [
        "libcrypto",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// Encoder Test Helper Library
cc_library_static {
    name: "libhevc_enc_helper",
    host_supported: false,
    srcs: [
        "encoder/EncHelper.cpp",
    ],
    export_include_dirs: ["encoder"],
    static_libs: [
        "libhevcenc",
        "libhevc_tests_common",
    ],
    shared_libs: [
        "libcrypto",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_test {
    name: "HevcTest",
    gtest: true,
    host_supported: false,
    test_suites: ["device-tests"],

    srcs: [
        "decoder/DecTests.cpp",
        "encoder/EncTests.cpp",
    ],

    static_libs: [
        "libhevcdec",
        "libhevcenc",
        "libhevc_dec_helper",
        "libhevc_enc_helper",
        "libhevc_tests_common",
    ],

    shared_libs: [
        "libcrypto",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    sanitize: {
        misc_undefined: [
            "signed-integer-overflow",
            "unsigned-integer-overflow",
        ],
        //cfi: true,
    },
}

// Decoder function tables for decoder unit tests
cc_library_static {
    name: "libhevc_tests_decoder",
    defaults: ["libhevc_tests_defaults"],
    srcs: [
        "decoder/dec_func_selector.cc",
    ],
    export_include_dirs: ["decoder"],
    static_libs: [
        "libhevc_tests_utils",
        "libhevcdec",
        "libgtest",
    ],
}

cc_test {
    name: "ihevcd_itrans_recon_dc_test",
    defaults: ["libhevc_tests_defaults"],
    srcs: ["decoder/ihevcd_itrans_recon_dc_test.cc"],
    static_libs: [
        "libhevc_tests_decoder",
        "libhevc_tests_utils",
        "libhevcdec",
    ],
}
